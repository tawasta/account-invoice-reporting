<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_invoice_document_sale_order_customer_marking"
    inherit_id="account.report_invoice_document"
  >
    <xpath expr="//div[@id='informations']" position="after">
      <div class="row mb-4" t-if="o.customer_marking" name="customer_marking">
        <div class="col-12">
          <strong>Customer Marking</strong>
          <div t-field="o.customer_marking" />
        </div>
      </div>
    </xpath>
  </template>
</odoo>
