<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_invoice_document_sale_order_customer_marking"
    inherit_id="account.report_invoice_document"
  >
    <xpath expr="//div[@name='customer_code']" position="after">
      <div
        t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2"
        t-if="o.customer_marking"
        name="customer_marking"
      >
        <strong>Customer Marking:</strong>
        <br />
        <span t-field="o.customer_marking" />
      </div>
    </xpath>
  </template>
</odoo>
