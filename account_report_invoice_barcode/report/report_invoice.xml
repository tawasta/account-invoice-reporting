<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//p[@name='payment_communication']/../.." position="after">
            <div
                id="barcode"
                t-if="o and o.barcode"
                class="row mt16 text-center last-page"
                style="height: 6rem;"
            >
                <img
                    t-att-src="'/report/barcode?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('Code128', o.barcode or '', 1600, 60)"
                    class="col-12"
                    style="width: 600px; height: 3rem; margin: auto; padding: 0; "
                />
                <span
                    t-field="o.barcode"
                    class="col-12"
                    style="font-size: 12px; font-weight: bold; text-align: center; margin: auto; padding: 0;"
                />
            </div>
        </xpath>

    </template>
</odoo>
