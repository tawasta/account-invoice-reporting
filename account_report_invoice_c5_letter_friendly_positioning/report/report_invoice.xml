<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- In invoice request the use of the C5-friendly address layout of
  web_report_c5_letter_friendly_positioning, and fetch its offsets (in millimeters) -->
  <template id="report_invoice_document" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@t-set='o']" position="before">
      <t t-set="use_c5_friendly_positioning" t-value="True" />
      <t
        t-set="c5_vertical_offset"
        t-value="float(env['ir.config_parameter'].sudo().get_param('account_report_invoice_c5_letter_friendly_positioning.vertical_offset', 0))"
      />
      <t
        t-set="c5_horizontal_offset"
        t-value="float(env['ir.config_parameter'].sudo().get_param('account_report_invoice_c5_letter_friendly_positioning.horizontal_offset', 0))"
      />
    </xpath>
  </template>
</odoo>
