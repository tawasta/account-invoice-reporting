<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hide.invoice.name</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting
                    id="setting_hide_invoice_name"
                    help="Hides the name field (e.g. 'Invoice INV/2025/001') on invoice PDFs"
                    company_dependent="1"
                >
                    <field name="hide_invoice_name" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
