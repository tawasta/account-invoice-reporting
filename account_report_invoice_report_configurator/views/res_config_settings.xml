<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">account.invoice.report.configurator.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">

                <block
                    title="Invoice PDF print"
                    name="invoice_report_setting_container"
                >
                    <setting
                        string="Bank Transfer Info"
                        help="Add a bank transfer section for invoices"
                    >
                        <field name="module_account_report_invoice_bank_transfer" />
                    </setting>

                    <setting string="Barcode" help="Show barcode in invoice PDF">
                        <field name="module_account_report_invoice_barcode" />
                    </setting>

                    <setting
                        string="Business Code"
                        help="Show business code in invoice PDF"
                    >
                        <field name="module_account_report_invoice_business_code" />
                    </setting>

                    <setting
                        string="Customer Contact"
                        help="Show customer contact in invoice PDF"
                    >
                        <field name="module_account_report_invoice_customer_contact" />
                    </setting>

                    <setting
                        string="Delivery Date"
                        help="Adds Delivery date to invoice PDF print"
                    >
                        <field name="module_account_report_invoice_delivery_date" />
                    </setting>

                    <setting
                        string="EORI"
                        help="Adds customer's EORI code to Account Invoice print"
                    >
                        <field name="module_account_report_invoice_eori" />
                    </setting>

                    <setting
                        string="Hide Customer Code"
                        help="Hide customer code from invoice PDF print"
                    >
                        <field
                            name="module_account_report_invoice_hide_customer_code"
                        />
                    </setting>

                    <setting
                        string="Hide Incoterm Under Note"
                        help="Invoice PDF - Hide incoterm located under the note"
                    >
                        <field
                            name="module_account_report_invoice_hide_incoterm_under_note"
                        />
                    </setting>

                    <setting
                        string="Hide Invoice Name"
                        help="Configurable option for hiding invoice name on print"
                    >
                        <field name="module_account_report_invoice_hide_invoice_name" />
                    </setting>

                    <setting
                        string="Hide Origin"
                        help="Hide origin from invoice PDF print"
                    >
                        <field name="module_account_report_invoice_hide_origin" />
                    </setting>

                    <setting
                        string="Hide Payment Communication"
                        help="Invoice PDF – Hide payment communication under note"
                    >
                        <field
                            name="module_account_report_invoice_hide_payment_communication"
                        />
                    </setting>

                    <setting
                        string="Hide Payment Term Under Note"
                        help="Invoice PDF – Hide payment term under note"
                    >
                        <field
                            name="module_account_report_invoice_hide_payment_term_under_note"
                        />
                    </setting>

                    <setting
                        string="Line Subtotal With Tax"
                        help="Include taxes in the subtotal of Invoice PDF print"
                    >
                        <field
                            name="module_account_report_invoice_line_subtotal_with_tax"
                        />
                    </setting>

                    <setting
                        string="Payment Terminology"
                        help="Changes 'invoice' to 'receipt' for PDF print and email template"
                    >
                        <field name="module_account_report_invoice_payment" />
                    </setting>

                    <setting
                        string="Payment Term Header"
                        help="Show payment term in invoice header"
                    >
                        <field
                            name="module_account_report_invoice_payment_term_header"
                        />
                    </setting>

                    <setting
                        string="Payment Term Text"
                        help="Show 'Payment terms:' text on Invoice pdf print"
                    >
                        <field name="module_account_report_invoice_payment_term_text" />
                    </setting>

                    <setting
                        string="Quantity Decimals"
                        help="Change the number of decimals shown on invoice PDF product quantities"
                    >
                        <field name="module_account_report_invoice_quantity_decimals" />
                    </setting>

                    <setting
                        string="Reformat Invoice Print"
                        help="Reformat invoice print elements for cleaner look"
                    >
                        <field name="module_account_report_invoice_reformat" />
                    </setting>

                    <setting
                        string="Sale Partner ID"
                        help="Show customer in invoice PDF"
                    >
                        <field name="module_account_report_invoice_sale_partner_id" />
                    </setting>

                    <setting
                        string="Salesperson"
                        help="Show salesperson in invoice PDF"
                    >
                        <field name="module_account_report_invoice_salesperson" />
                    </setting>

                    <setting
                        string="Show Invoice Address"
                        help="Show Invoice address text above Customer info in Invoice PDF print"
                    >
                        <field
                            name="module_account_report_invoice_show_invoice_address"
                        />
                    </setting>
                </block>

            </xpath>
        </field>
    </record>
</odoo>
