<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="report_invoice_document" inherit_id="account.report_invoice_document">
    <xpath expr="//p[@name='payment_communication']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
    <xpath expr="//p[@name='payment_communication']/../.." position="after">
      <p
        t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
        name="payment_communication_info"
      >
        <!-- inlines style fixes issue where bank transfer section contents would go over the invoice sum section -->
        <div
          id="bank_transfer"
          class="row mt32 mb16"
          style="page-break-inside: avoid; break-inside: avoid-page;"
        >
          <div class="col-auto col-4 mw-100 mb-2" name="payment_recipient">
            <strong>Payment recipient:</strong>
            <p
              t-if="o.partner_bank_id.acc_holder_name"
              class="m-0"
              t-field="o.partner_bank_id.acc_holder_name"
            />
            <p t-else="" class="m-0" t-field="o.partner_bank_id.partner_id.name" />
          </div>

          <div
            class="col-auto col-4 mw-100 mb-2"
            t-if="o.payment_reference"
            name="payment_reference"
          >
            <strong>Payment reference:</strong>
            <p class="m-0" t-field="o.payment_reference" />
          </div>

          <div
            class="col-auto col-4 mw-100 mb-2"
            t-if="o.partner_bank_id"
            name="partner_bank_id"
          >
            <strong>IBAN/BIC:</strong>
            <p class="m-0" t-field="o.partner_bank_id.acc_number" />
            <p class="m-0" t-field="o.partner_bank_id.bank_bic" />
          </div>
        </div>
      </p>
    </xpath>
  </template>
</odoo>
