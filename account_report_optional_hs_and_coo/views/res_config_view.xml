<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">res.config.settings.show.hs.and.coo</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="account.res_config_settings_view_form" />
		<field name="arch" type="xml">
            <block id="invoicing_settings" position="inside">
                <setting
                    id="invoice_report_show_hs_and_coo"
                    help="Displays HS Code and Country Of Origin by default in invoice PDF print"
                >
                    <field name="always_show_hs_code_and_coo" />
                </setting>
            </block>
		</field>
	</record>
</odoo>
