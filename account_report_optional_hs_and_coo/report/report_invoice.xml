<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_invoice_document_hs"
        inherit_id="account_report_invoice_hs_code.report_invoice_document"
    >
        <xpath expr="//th[@name='th_hs_code']" position="attributes">
            <attribute name="t-if">o.show_hs_code_and_coo</attribute>
        </xpath>
        <xpath expr="//td[@name='td_hs_code']" position="attributes">
            <attribute name="t-if">o.show_hs_code_and_coo</attribute>
        </xpath>
    </template>

    <template
        id="report_invoice_document_coo"
        inherit_id="account_report_invoice_country_of_origin.report_invoice_document"
    >
        <xpath expr="//th[@name='th_country_of_origin']" position="attributes">
            <attribute name="t-if">o.show_hs_code_and_coo</attribute>
        </xpath>
        <xpath expr="//td[@name='td_country_of_origin']" position="attributes">
            <attribute name="t-if">o.show_hs_code_and_coo</attribute>
        </xpath>
    </template>
</odoo>
