<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//address[@t-field='o.partner_id']" position="before">
            <t
                t-if="env['ir.config_parameter'].sudo().get_param('account_report_invoice_show_customer_info.show_customer_address')"
            >
                <div style="margin-bottom: 10px;">

                    <strong>Customer address:</strong><br />

                    <t t-if="o.sale_partner_id.name">
                        <span t-field="o.sale_partner_id.name" /><br />
                    </t>

                    <t t-if="o.sale_partner_id.street">
                        <span t-field="o.sale_partner_id.street" /><br />
                    </t>

                    <t t-if="o.sale_partner_id.zip or o.sale_partner_id.city">
                        <span
                            t-if="o.sale_partner_id.zip"
                            t-field="o.sale_partner_id.zip"
                        />
                        <span
                            t-if="o.sale_partner_id.city"
                            t-field="o.sale_partner_id.city"
                        />
                        <br />
                    </t>

                    <t t-if="o.sale_partner_id.country_id">
                        <span t-field="o.sale_partner_id.country_id.name" />
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
