<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template
    id="report_account_invoice_document_title"
    inherit_id="account.report_invoice_document"
  >
    <xpath expr="//t[@t-set='o']" position="before">
      <t t-set="report_title">
        <t t-if="o.is_down_payment_invoice() and not o.is_refund_invoice()">
                    Down payment
                </t>
        <t t-elif="o.move_type in ['out_refund', 'in_refund']">
                    Refund
                </t>
        <t t-else="">Invoice</t>
        <span t-if="o.name != '/'" t-esc="o.name" />
      </t>
    </xpath>
  </template>

  <template
    id="report_account_invoice_document_h2element"
    inherit_id="account.report_invoice_document"
  >
    <xpath expr="//t[@name='invoice_title']" position="attributes">
      <attribute name="t-if">not o.is_down_payment_invoice()</attribute>
    </xpath>
    <xpath expr="//t[@name='invoice_title']" position="after">
      <t t-if="o.is_down_payment_invoice()">Down payment</t>
    </xpath>
  </template>

  <template
    id="report_account_invoice_document_down_payment_product_lines"
    inherit_id="account.report_invoice_document"
  >
    <xpath expr="//table[contains(@class, 'o_main_table')]" position="after">
      <t t-if="o.is_down_payment_invoice()">
        <t
          t-set="down_payment_sale_orders"
          t-value="o.get_down_payment_sale_orders()"
        />
        <table class="table table-sm mt-2">
          <thead>
            <tr>
              <th>Description</th>
              <th class="text-end">Quantity</th>
              <th class="text-end">Unit Price</th>
              <th class="text-end">Price before taxes</th>
              <th class="text-end">VAT %</th>
              <th class="text-end">VAT Amount</th>
              <th class="text-end">Total price</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="down_payment_sale_orders" t-as="so">
              <t t-foreach="so.order_line" t-as="line">
                <tr t-if="not line.is_downpayment">
                  <td>
                    <span t-esc="line.name" />
                  </td>
                  <td class="text-end">
                    <span t-esc="line.product_uom_qty" />
                  </td>
                  <td class="text-end">
                    <span t-esc="line.price_unit" />
                  </td>
                  <td class="text-end">
                    <span t-esc="line.price_subtotal" />
                  </td>
                  <td class="text-end">
                    <span
                      t-esc="', '.join(str(tax.amount) + '%' for tax in line.tax_ids)"
                    />
                  </td>
                  <td class="text-end">
                    <span t-esc="line.price_tax" />
                  </td>
                  <td class="text-end">
                    <span t-esc="line.price_total" />
                  </td>
                </tr>
              </t>
            </t>
          </tbody>
        </table>
      </t>
    </xpath>
  </template>
</odoo>
